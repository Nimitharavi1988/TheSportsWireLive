// Prisma schema — matches the data model in the architecture plan.
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

// Deliberately NOT setting engineType = "client" — that mode's WASM query
// compiler is intrinsic to the generated code (not a separate downloadable
// file), so `prisma generate --no-engine` can't strip it out; confirmed via
// a real deploy that still hit the same WASM compile crash on Cloudflare
// Workers even with --no-engine. The classic engine (this default) plus
// `--no-engine` on the Cloudflare build specifically produces a client with
// zero local engine at all, for Accelerate. Locally, the classic engine
// works fine via `prisma generate` (no flag) with the Neon driver adapter —
// Node.js has none of the eval/WASM restrictions Workers has.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Switch to "mysql" if your shared hosting only offers MySQL.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  ingested
  auto_checked
  flagged
  pending_review
  approved
  published
  rejected
}

enum SocialPlatform {
  facebook
  x
  instagram
}

enum SocialPostStatus {
  queued
  posted
  failed
}

model Vertical {
  id                       String    @id @default(cuid())
  name                     String    @unique // e.g. "sports"
  domain                   String?
  facebookPageId           String?   // Page to post this vertical's approved articles to
  facebookPageAccessToken  String?   // long-lived Page access token for that Page
  articles                 Article[]
  sources                  Source[]
  createdAt                DateTime  @default(now())
}

model Article {
  id               String         @id @default(cuid())
  verticalId       String
  vertical         Vertical       @relation(fields: [verticalId], references: [id])
  title            String
  slug             String         @unique
  summary          String         // short teaser — used for the social post text, homepage card, and meta description
  body             String?        // fuller content for the article detail page; null until enrichment fills it in
  sourceUrl        String
  sourceName       String
  category         String         // e.g. "football", "football/world-cup", "cricket"
  status           ArticleStatus  @default(ingested)
  profanityFlag    Boolean        @default(false)
  profanityDetail  String?        // which terms/fields triggered it
  readabilityScore Float?
  trendingScore    Float          @default(0)
  reviewedBy       String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  dedupeHash       String         @unique // used to catch the same story from multiple sources
  homeCrestUrl     String?        // team crest image, when the source provides one (used for social preview images)
  awayCrestUrl     String?
  heroImageUrl     String?        // generic stock photo, for articles with no crest (e.g. RSS news)
  heroImageCredit  String?        // "Photo by {name} on Pexels" — required attribution text
  heroImageCreditUrl String?      // link to the photographer's Pexels profile
  featured         Boolean        @default(false) // manually picked by an admin as the homepage hero; falls back to automatic ranking when no article has this set
  highlighted      Boolean        @default(false) // manually pinned into "Transfers & Big News"; adds to (doesn't replace) the automatic keyword match
  socialPosts      SocialPost[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([category])
}

model SocialPost {
  id             String            @id @default(cuid())
  articleId      String
  article        Article           @relation(fields: [articleId], references: [id])
  platform       SocialPlatform
  status         SocialPostStatus  @default(queued)
  externalPostId String?
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime          @default(now())
}

model Source {
  id           String   @id @default(cuid())
  verticalId   String
  vertical     Vertical @relation(fields: [verticalId], references: [id])
  name         String   // e.g. "football-data.org"
  type         String   // "api" | "rss"
  config       Json     // API key ref, competition IDs, feed URL, etc.
  lastPolledAt DateTime?
  createdAt    DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}
