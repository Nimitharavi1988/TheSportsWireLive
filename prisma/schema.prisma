// Prisma schema — matches the data model in the architecture plan.
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

// Deliberately NOT setting engineType = "client" — that mode's WASM query
// compiler is intrinsic to the generated code (not a separate downloadable
// file), so `prisma generate --no-engine` can't strip it out; confirmed via
// a real deploy that still hit the same WASM compile crash on Cloudflare
// Workers even with --no-engine. The classic engine (this default) plus
// `--no-engine` on the Cloudflare build specifically produces a client with
// zero local engine at all, for Accelerate. Locally, the classic engine
// works fine via `prisma generate` (no flag) with the Neon driver adapter —
// Node.js has none of the eval/WASM restrictions Workers has.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Switch to "mysql" if your shared hosting only offers MySQL.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  ingested
  auto_checked
  flagged
  pending_review
  approved
  published
  rejected
}

enum SocialPlatform {
  facebook
  x
  instagram
}

enum SocialPostStatus {
  queued
  posted
  failed
}

model Vertical {
  id                       String    @id @default(cuid())
  name                     String    @unique // e.g. "sports"
  domain                   String?
  facebookPageId           String?   // Page to post this vertical's approved articles to
  facebookPageAccessToken  String?   // long-lived Page access token for that Page
  articles                 Article[]
  sources                  Source[]
  createdAt                DateTime  @default(now())
}

model Article {
  id               String         @id @default(cuid())
  verticalId       String
  vertical         Vertical       @relation(fields: [verticalId], references: [id])
  title            String
  slug             String         @unique
  summary          String         // short teaser — used for the social post text, homepage card, and meta description
  body             String?        // fuller content for the article detail page; null until enrichment fills it in
  sourceUrl        String
  sourceName       String
  category         String         // e.g. "football", "football/world-cup", "cricket"
  status           ArticleStatus  @default(ingested)
  profanityFlag    Boolean        @default(false)
  profanityDetail  String?        // which terms/fields triggered it
  readabilityScore Float?
  trendingScore    Float          @default(0)
  reviewedBy       String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  dedupeHash       String         @unique // used to catch the same story from multiple sources
  homeCrestUrl     String?        // team crest image, when the source provides one (used for social preview images)
  awayCrestUrl     String?
  heroImageUrl     String?        // generic stock photo, for articles with no crest (e.g. RSS news)
  heroImageCredit  String?        // "Photo by {name} on Pexels" — required attribution text
  heroImageCreditUrl String?      // link to the photographer's Pexels profile
  featured         Boolean        @default(false) // manually picked for the homepage hero carousel — up to 5 at a time, oldest pick auto-retired when a 6th is added; auto-fills with top trending stories when fewer than 5 are picked
  featuredAt       DateTime?      // when this pick was made — determines hero order (latest first) and which pick gets retired when the cap is exceeded
  highlighted      Boolean        @default(false) // manually pinned into "Transfers & Big News"; adds to (doesn't replace) the automatic keyword match
  highlightedAt    DateTime?      // when this pick was made — determines display order (latest first) among highlighted articles
  playerNewsSourced Boolean       @default(false) // from the per-player Google News search (playerNewsFeeds.ts) — body is deliberately never generated for these (see runIngest.ts), so a null body here means "finished" (summary + real photo + source link), not "not yet enriched". Lets autoApprove.ts tell the two apart instead of treating every body-less article the same.
  // Structured match data, set only for football-data.org/CricketData.org/
  // ESPN NFL items (footballData.ts/cricketData.ts/nflData.ts already have
  // all of this before flattening it into the title/body prose — this
  // preserves it instead of discarding it). Powers /scores and the
  // multi-sport MatchTicker without needing to regex-parse titles.
  homeTeam         String?
  awayTeam         String?
  homeScore        Int?
  awayScore        Int?
  matchStatus      String?        // "scheduled" | "finished"
  kickoffAt        DateTime?      // the match's real kickoff/start time — distinct from publishedAt, which for a "finished" match is when it ended, not when it started
  socialPosts      SocialPost[]
  poll             Poll?
  reactions        ArticleReaction[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([category])
  @@index([matchStatus, kickoffAt])
}

model SocialPost {
  id             String            @id @default(cuid())
  articleId      String
  article        Article           @relation(fields: [articleId], references: [id])
  platform       SocialPlatform
  status         SocialPostStatus  @default(queued)
  externalPostId String?
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime          @default(now())
}

model Source {
  id           String   @id @default(cuid())
  verticalId   String
  vertical     Vertical @relation(fields: [verticalId], references: [id])
  name         String   // e.g. "football-data.org"
  type         String   // "api" | "rss"
  config       Json     // API key ref, competition IDs, feed URL, etc.
  lastPolledAt DateTime?
  createdAt    DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// Fan engagement — polls, reactions, and the sentiment leaderboard. No user
// accounts on the site (only staff/admin auth exists), so voting is
// anonymous, identified by a long-lived cookie (see src/lib/voterCookie.ts)
// rather than a userId — enforced server-side via the unique constraints
// below, not just client-side state (which is trivially bypassable).
model Poll {
  id        String       @id @default(cuid())
  articleId String       @unique // one poll per article — hand-curated by an admin, not auto-generated (see PLAN.md's reasoning: predictive/speculative questions are a different content category from this site's strictly fact-grounded editorial line)
  article   Article      @relation(fields: [articleId], references: [id])
  question  String
  options   PollOption[]
  votes     PollVote[]
  createdAt DateTime     @default(now())
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  // Cascades, unlike Article's own relations elsewhere in this file — a
  // poll option (and its votes) has no meaning once the poll is deleted,
  // whereas we never delete Articles at all. See admin/actions.ts's
  // deletePoll, the deliberate "start over" recovery path for a poll.
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  cookieId  String
  ipAddress String?    // for abuse monitoring only, never used as an identity key
  createdAt DateTime   @default(now())

  @@unique([pollId, cookieId]) // one vote per poll per anonymous visitor
  @@index([optionId])
}

enum ReactionType {
  hype
  panic
  neutral
}

model ArticleReaction {
  id        String       @id @default(cuid())
  articleId String
  article   Article      @relation(fields: [articleId], references: [id])
  type      ReactionType
  cookieId  String
  ipAddress String?
  createdAt DateTime     @default(now())

  @@unique([articleId, cookieId]) // one reaction per article per anonymous visitor — changing it is an upsert, not a second row
  @@index([articleId, type])
}
