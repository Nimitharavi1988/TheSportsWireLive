# Copy this file to .env and fill in real values. Never commit .env.

# Database — Postgres shown; swap the schema.prisma provider to "mysql" if that's what your host offers
DATABASE_URL=""

# Sports data sources
FOOTBALL_DATA_API_KEY=""      # from football-data.org — free tier signup
# CRICKETDATA_API_KEY=""      # from cricketdata.org — add when cricket ingestion is wired up

# Facebook (Meta Graph API) — see plan section 4 for full setup steps
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Admin auth
SESSION_SECRET=""              # any long random string, e.g. `openssl rand -hex 32`

# Cron protection — random string you also put in your cron job's request header
CRON_SECRET=""

# Public site URL, used when composing social post links
SITE_URL="https://yourdomain.com"
