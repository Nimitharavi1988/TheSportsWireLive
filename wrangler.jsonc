{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thesportswirelive",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // SITE_URL was never set in production, so every `process.env.SITE_URL ??
  // "http://localhost:3000"` fallback across the codebase (canonical URLs,
  // og:url, JSON-LD, share-button links) was silently resolving to
  // localhost on the live site — confirmed directly: sportswirelive.com's
  // own canonical tag and WhatsApp share link both pointed at
  // localhost:3000.
  "vars": {
    "SITE_URL": "https://sportswirelive.com",
    // Not secret — a Page ID is publicly visible on the Page itself. The
    // access token is the actual secret and must never go here (this file
    // is committed to git); it's set as a Cloudflare secret instead, via
    // the dashboard (Workers & Pages -> thesportswirelive -> Settings ->
    // Variables and Secrets -> Add -> FACEBOOK_PAGE_ACCESS_TOKEN, encrypted).
    "FACEBOOK_PAGE_ID": "1287339801134616",
    // Also not secret — same reasoning as FACEBOOK_PAGE_ID above. Reuses
    // the same FACEBOOK_PAGE_ACCESS_TOKEN Cloudflare secret to post here.
    "INSTAGRAM_BUSINESS_ACCOUNT_ID": "17841426520820898",
    // A GA4 Measurement ID is meant to be public (it's shipped straight into
    // the page's own <script> tag for every visitor's browser to see) — not
    // a secret, same reasoning as the two IDs above. GoogleAnalytics.tsx
    // (a Server Component, not "use client") reads this via process.env at
    // render time, the same pattern already proven working here for
    // SITE_URL/FACEBOOK_PAGE_ID — no separate Cloudflare build-time
    // environment variable needed.
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-K8STQKWCBP"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "thesportswirelive"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "sports-wire-live-cache"
    }
  ]
}
